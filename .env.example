# Copy to .env and adjust. Never commit .env.
F1TEL_DATABASE_URL=postgresql+psycopg://f1tel:f1tel@localhost:5432/f1tel
F1TEL_DATA_DIR=data
F1TEL_FASTF1_CACHE_DIR=.fastf1-cache
F1TEL_GRID_STEP_M=10
F1TEL_HTTP_TIMEOUT_S=20
F1TEL_HTTP_MAX_RETRIES=4
F1TEL_JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
F1TEL_OPENF1_BASE_URL=https://api.openf1.org/v1
F1TEL_CORS_ORIGINS=http://localhost:5173
F1TEL_FUEL_EFFECT_S_PER_LAP=0.03
# docker compose
POSTGRES_USER=f1tel
POSTGRES_PASSWORD=f1tel
POSTGRES_DB=f1tel
